# Gemini API
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.5-flash-preview-05-20
GEMINI_LIGHT_MODEL=gemini-2.0-flash-lite
GEMINI_THINKING_BUDGET=0

# claude -p バックエンド（任意。docs/CLAUDE_CLI_BACKEND.md）
# MEMORIA_AGENT_BACKEND=claude_cli
# CLAUDE_CLI_MODEL=sonnet
# CLAUDE_CLI_CHAT_MODEL=haiku
# CLAUDE_CLI_DEEP_MODEL=opus
# CLAUDE_CLI_LIGHT_MODEL=haiku
# claude -p の代わりに codex exec で動かす（未設定なら claude）
# LLM_CLI_BACKEND=codex
# CODEX_CLI_HOME=/path/to/codex-home-for-memoria
# CODEX_CLI_COMMAND=/path/to/codex
# CODEX_CLI_MODEL=gpt-6.1-sol:medium
# CODEX_CLI_CHAT_MODEL=gpt-6-luna:medium
# CODEX_CLI_DEEP_MODEL=gpt-6.1-sol:high
# CODEX_CLI_LIGHT_MODEL=gpt-6-luna:low

# Vault
VAULT_ROOT=~/memoria-vaults

# Discord Bot
# DISCORD_BOT_TOKEN=your_bot_token_here
# DISCORD_CHANNEL_ID=your_channel_id_here
# 応答する相手のDiscordユーザーID（","区切り。未設定ならチャンネルの全員に応答）
# DISCORD_ALLOWED_USER_IDS=your_user_id_here

# MemoriaServer (MS)
# Redis 接続URL（pub/sub 用）。デフォルト: redis://localhost:6379/0
# MS_REDIS_URL=redis://localhost:6379/0
# APIキーハッシュのペッパー。本番では必ず長いランダム値に変更すること。
# MS_KEY_PEPPER=please-generate-a-long-random-string-for-production
# 使用するアダプタ。memoria_core (default) / http / "MyApp::MyAdapter" 形式のクラス名
# MS_ADAPTER=memoria_core
# HTTPアダプタ使用時の外部エンドポイントURL
# MS_ADAPTER_URL=http://localhost:8080
# MS_ADAPTER_TIMEOUT=120
